---
import { getCollection } from 'astro:content';
import Play from '../../layouts/Play.astro';
import { resolveAssetUrl } from '../../utils';

export async function getStaticPaths() {
  const items = await getCollection('animations');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const src = resolveAssetUrl(entry.data.embed, base);
const backHref = `${base}animations/`;
---
<Play title={entry.data.title} back backHref={backHref}>
  <iframe
    class="play-frame"
    src={src}
    title={entry.data.title}
    allow="fullscreen; autoplay"
    allowfullscreen
  ></iframe>
</Play>
