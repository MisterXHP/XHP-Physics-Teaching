---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { topicByName } from '../data/topics';
import { sortByDateDesc, formatDate } from '../utils';

const base = import.meta.env.BASE_URL;

const animations = sortByDateDesc(await getCollection('animations'));
const lectures = sortByDateDesc(await getCollection('lectures'));

/* 首页两个板块都按时间倒序取最新 9 条（一行 3 个、最多 3 排） */
const latestAnimations = animations.slice(0, 9);
const latestLectures = lectures.slice(0, 9);

function topicName(name: string) {
  return topicByName(name)?.name ?? name;
}
---
<Base>
  <section class="hero">
    <h1 class="page-title">大熊印象 · 物理星河</h1>
    <p class="hero__lead">
      这里有可以动手操作的新知动画，以及图文并茂的教学讲义。<br />
      希望它能帮到每一位正在学物理、教物理的人。
    </p>
  </section>

  <h2 class="section-title">
    最新动画
    <a href={`${base}animations/`}>查看全部 →</a>
  </h2>
  {latestAnimations.length === 0 ? (
    <p class="notice">还没有动画，去后台添加第一个吧。</p>
  ) : (
    <div class="grid grid3">
      {latestAnimations.map((it) => (
        <Card
          href={`${base}play/${it.id}/`}
          icon="play"
          cover={it.data.cover ? `${base}${it.data.cover}` : undefined}
          label={topicName(it.data.topic)}
          title={it.data.title}
          desc={it.data.summary}
          meta={formatDate(it.data.date)}
        />
      ))}
    </div>
  )}

  <h2 class="section-title">
    最新讲义
    <a href={`${base}lectures/`}>查看全部 →</a>
  </h2>
  {latestLectures.length === 0 ? (
    <p class="notice">还没有讲义。</p>
  ) : (
    <div class="grid grid3">
      {latestLectures.map((it) => (
        <Card
          href={`${base}lectures/${it.id}/`}
          icon="doc"
          label={topicName(it.data.topic)}
          title={it.data.title}
          desc={it.data.summary}
          meta={formatDate(it.data.date)}
        />
      ))}
    </div>
  )}
</Base>

<style>
  .hero {
    padding: 28px 0 12px;
    text-align: center;
  }
  /* 「一行 3 个」的 .grid3 已收进 global.css（首页与动画/讲义列表页共用） */
  .hero__lead {
    font-size: 18px;
    color: var(--text-muted);
    max-width: 760px;
    margin: 10px auto 0;
    text-align: justify;
    text-justify: inter-ideograph;
  }
  /* 窄屏下两端对齐会把中文行内字距拉得很散，改回左对齐 */
  @media (max-width: 640px) {
    .hero {
      padding: 16px 0 8px;
    }
    .hero__lead {
      font-size: 16px;
      margin-top: 12px;
      text-align: left;
      text-justify: auto;
    }
  }
</style>
