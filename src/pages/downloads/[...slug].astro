---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { topicByName } from '../../data/topics';
import { resolveAssetUrl, formatDate } from '../../utils';

export async function getStaticPaths() {
  const items = await getCollection('downloads');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const topic = topicByName(entry.data.topic);
const { Content } = await render(entry);

const file = entry.data.file;
const fileSrc = file ? resolveAssetUrl(file, base) : '';
---
<Base title={entry.data.title} description={entry.data.summary}>
  <p><a href={`${base}downloads/`}>← 返回下载库</a></p>
  <h1 class="page-title">{entry.data.title}</h1>
  <p class="page-lead">
    {topic && (
      <a class="tag tag--primary" href={`${base}topics/${topic.slug}/`}>{topic.name}</a>
    )}
    <span class="card__meta">
      {[entry.data.format, entry.data.size, formatDate(entry.data.date)].filter(Boolean).join(' · ')}
    </span>
  </p>

  <div class="embed-toolbar">
    {fileSrc ? (
      <a class="btn" href={fileSrc} download>下载文件 ↓</a>
    ) : (
      <span class="notice">下载文件尚未上传。</span>
    )}
  </div>

  <article class="prose">
    <Content />
  </article>
</Base>
