---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { topics, topicByName } from '../../data/topics';
import { sortByDateDesc, formatDate } from '../../utils';

const base = import.meta.env.BASE_URL;
const items = sortByDateDesc(await getCollection('animations'));
---
<Base title="交互动画">
  <header class="list-head">
    <h1 class="page-title">交互动画</h1>
    <p class="page-lead">可以动手操作的物理模拟。点击卡片即可全屏打开，用鼠标和滑块探索其中的物理规律。</p>
  </header>

  <nav class="topic-bar">
    {topics.map((t) => (
      <a href={`${base}topics/${t.slug}/?from=animations`}>{t.name}</a>
    ))}
  </nav>

  {items.length === 0 ? (
    <p class="notice">还没有交互动画。</p>
  ) : (
    <div class="grid">
      {items.map((it) => (
        <Card
          href={`${base}play/${it.id}/`}
          icon="play"
          external
          label={topicByName(it.data.topic)?.name ?? it.data.topic}
          title={it.data.title}
          desc={it.data.summary}
          meta={formatDate(it.data.date)}
        />
      ))}
    </div>
  )}
</Base>
