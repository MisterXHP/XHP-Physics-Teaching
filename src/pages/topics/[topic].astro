---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { topics } from '../../data/topics';
import { sortByDateDesc, formatDate } from '../../utils';

export async function getStaticPaths() {
  return topics.map((t) => ({ params: { topic: t.slug }, props: { topic: t } }));
}

const { topic } = Astro.props;
const base = import.meta.env.BASE_URL;

const [animations, lectures, experiments, downloads] = await Promise.all([
  getCollection('animations'),
  getCollection('lectures'),
  getCollection('experiments'),
  getCollection('downloads'),
]);

const pick = (arr: { data: { topic: string; date?: Date } }[]) =>
  sortByDateDesc(arr.filter((x) => x.data.topic === topic.name));

const groups = [
  { label: '交互动画', lib: 'animations', href: 'play', icon: 'play', items: pick(animations) },
  { label: '教学讲义', lib: 'lectures', href: 'lectures', icon: 'doc', items: pick(lectures) },
  { label: '演示实验', lib: 'experiments', href: 'experiments', icon: 'flask', items: pick(experiments) },
  { label: '其它资源', lib: 'downloads', href: 'downloads', icon: 'download', items: pick(downloads) },
];

const shown = groups.filter((g) => g.items.length > 0);
---
<Base title={topic.name} description={topic.desc} back backHref="history">
  <header class="list-head topic-head">
    {/* 默认标题（无来源参数时显示） */}
    <h1 class="page-title topic-title-topic">{topic.name}</h1>
    {/* 带来源参数时，改为「区域 · 主题」样式（由 CSS 切换显示） */}
    {shown.map((g) => (
      <h1 class="page-title topic-title-lib" data-lib={g.lib}>{g.label} · {topic.name}</h1>
    ))}
  </header>

  {shown.length === 0 ? (
    <p class="notice">这个主题下暂时还没有内容。</p>
  ) : (
    shown.map((g) => (
      <section data-lib={g.lib}>
        <h2 class="section-title topic-group-title">{g.label} · {topic.name}</h2>
        <div class="grid">
          {g.items.map((it) => (
            <Card
              href={`${base}${g.href}/${it.id}/`}
              icon={g.icon}
              external={g.href === 'play'}
              label={topic.name}
              title={it.data.title}
              desc={it.data.summary}
              meta={formatDate(it.data.date)}
            />
          ))}
        </div>
      </section>
    ))
  )}
</Base>
