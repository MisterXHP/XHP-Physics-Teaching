---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { topicByName } from '../../data/topics';
import { resolveAssetUrl, formatDate } from '../../utils';

export async function getStaticPaths() {
  const items = await getCollection('experiments');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const topic = topicByName(entry.data.topic);
const { Content } = await render(entry);

const video = entry.data.video;
const videoSrc = video ? resolveAssetUrl(video, base) : '';
const isFile = /\.(mp4|webm|ogg|mov)$/i.test(videoSrc);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <p><a href={`${base}experiments/`}>← 返回实验库</a></p>
  <h1 class="page-title">{entry.data.title}</h1>
  <p class="page-lead">
    {topic && (
      <a class="tag tag--primary" href={`${base}topics/${topic.slug}/`}>{topic.name}</a>
    )}
    <span class="card__meta"> {formatDate(entry.data.date)}</span>
  </p>

  {videoSrc ? (
    isFile ? (
      <video class="embed-frame" src={videoSrc} controls playsinline style="width:100%; background:#000;"></video>
    ) : (
      <div class="embed-frame">
        <iframe src={videoSrc} title={entry.data.title} loading="lazy" allowfullscreen></iframe>
      </div>
    )
  ) : (
    <p class="notice">该实验演示的媒体尚未上传。</p>
  )}

  <article class="prose" style="margin-top: 28px;">
    <Content />
  </article>
</Base>
