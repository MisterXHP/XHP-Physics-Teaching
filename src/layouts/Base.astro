---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const SITE = '大熊印象 · 物理星河';

interface Props {
  title?: string;
  description?: string;
  back?: boolean;
  backHref?: string;
}
const {
  title,
  description = '熊和平（大熊印象）的中学物理新知动画与教学讲义。',
  back = false,
  backHref,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE}` : SITE;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{fullTitle}</title>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('hm_theme');
          if (t !== 'light' && t !== 'dark') t = 'dark';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
        try {
          var m = /[?&]from=([a-z]+)/.exec(location.search);
          if (m) document.documentElement.setAttribute('data-from', m[1]);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Header back={back} backHref={backHref} />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
