---
import Icon from './Icon.astro';

interface Props {
  back?: boolean;
  backHref?: string;
}
const { back = false, backHref } = Astro.props;

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const home = base.replace(/\/$/, '');

const links = [
  { href: base, label: '首页' },
  { href: `${base}animations/`, label: '交互动画' },
  { href: `${base}lectures/`, label: '教学讲义' },
  { href: `${base}experiments/`, label: '演示实验' },
  { href: `${base}downloads/`, label: '其它资源' },
  { href: `${base}search/`, label: '搜索' },
];

function isActive(href: string): boolean {
  if (href === base) return path.replace(/\/$/, '') === home;
  return path.startsWith(href);
}
---
<header class="site-header">
  <div class="container site-header__inner">
    {back && (
      backHref === 'history' ? (
        <a class="back-btn" href="#" onclick="history.back();return false;" aria-label="返回上一页">
          <Icon name="back" size={18} />
          <span class="back-btn__text">返回</span>
        </a>
      ) : (
        <a class="back-btn" href={backHref ?? `${base}animations/`} aria-label="返回">
          <Icon name="back" size={18} />
          <span class="back-btn__text">返回</span>
        </a>
      )
    )}
    <a class="brand" href={base}>
      <Icon name="atom" size={22} />
      <span>大熊印象 · 物理星河</span>
    </a>
    <nav class="nav" id="site-nav">
      {links.map((l) => (
        <a href={l.href} class={isActive(l.href) ? 'active' : ''}>{l.label}</a>
      ))}
    </nav>
    <button class="theme-toggle" id="theme-toggle" aria-label="切换深浅主题" title="切换深浅主题">🌙</button>
    <button
      class="menu-toggle"
      id="menu-toggle"
      type="button"
      aria-label="打开导航菜单"
      aria-controls="site-nav"
      aria-expanded="false"
    >
      <span class="menu-toggle__open"><Icon name="menu" size={22} /></span>
      <span class="menu-toggle__close"><Icon name="close" size={22} /></span>
    </button>
  </div>
</header>
<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');
  function render() {
    if (btn) btn.textContent = root.getAttribute('data-theme') === 'light' ? '☀️' : '🌙';
  }
  btn?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('hm_theme', next);
    } catch (e) {}
    render();
  });
  render();

  /* 窄屏导航抽屉 */
  const nav = document.getElementById('site-nav');
  const menuBtn = document.getElementById('menu-toggle');
  function setMenu(open: boolean) {
    if (!nav || !menuBtn) return;
    nav.classList.toggle('open', open);
    menuBtn.classList.toggle('is-open', open);
    menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    menuBtn.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
  }
  menuBtn?.addEventListener('click', () => setMenu(!nav?.classList.contains('open')));
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (nav?.classList.contains('open') && !t.closest('.site-header')) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth > 880) setMenu(false);
  });
</script>
